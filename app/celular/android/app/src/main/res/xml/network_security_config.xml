<?xml version="1.0" encoding="utf-8"?>
<!-- Dente Sempre: só conexões com cadeado (https), e só certificados oficiais
     do sistema (certificados instalados pelo usuário não valem). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
